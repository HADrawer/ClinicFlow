POSTGRES_DB=clinicflow
POSTGRES_USER=clinicflow
POSTGRES_PASSWORD=clinicflow
DATABASE_URL=postgresql+psycopg://clinicflow:clinicflow@db:5432/clinicflow
JWT_SECRET=replace-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_API_ORIGIN=
PRIVATE_UPLOAD_DIR=./private_uploads
MAX_UPLOAD_BYTES=10485760
ENVIRONMENT=development
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:3000
INVITATION_EXPIRY_HOURS=72

# BACKEND_API_ORIGIN is server-only (never NEXT_PUBLIC_*) and is read by
# frontend/next.config.ts to build a same-origin proxy: the browser calls
# /backend-api/* on the frontend's own origin, and Next.js forwards that
# server-side to ${BACKEND_API_ORIGIN}/api/*. The browser never learns the
# backend's real host, port, or origin.
#   docker compose (default, no need to set it yourself): http://backend:8000
#   Vercel: the deployed FastAPI project's own origin, e.g.
#           https://clinic-flow-api.vercel.app
#
# Local LAN / phone testing: the phone only ever talks to the frontend's own
# address on port 3000 — it no longer needs the backend's LAN IP or port
# 8000 at all, so BACKEND_API_ORIGIN never changes for this. Only
# APP_BASE_URL (used to build invitation links) needs the computer's current
# LAN address:
#   APP_BASE_URL=http://<computer-LAN-IP>:3000
# These are development-only values. Vercel production uses the environment
# variables configured in the Vercel dashboard, never these local overrides.
